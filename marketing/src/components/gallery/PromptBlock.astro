---
/**
 * A prompt in one language, in its own block with a Copy button. The button
 * is wired up by the script on the recipe page.
 */
interface Props {
  /** Unique on the page; the Copy button points at it. */
  id: string;
  heading: string;
  text: string;
  /** The language of the text, when it is not the page's. */
  lang?: string;
  /** A short remark beside the heading, e.g. that the text is a machine translation. */
  note?: string;
}

const { id, heading, text, lang, note } = Astro.props;
---

<section class="card p-0 overflow-hidden" data-prompt-block={lang ?? 'en'}>
  <header class="flex items-center justify-between gap-3 px-4 py-2.5 border-b border-border bg-bg-muted">
    <h3 class="text-sm font-semibold text-fg">
      {heading}
      {note && <span class="ml-2 pill pill-amber align-middle" data-prompt-note>{note}</span>}
    </h3>
    <button type="button" class="btn btn-secondary btn-sm" data-copy={id}>Copy</button>
  </header>
  <p id={id} lang={lang} class="gallery-prompt px-4 py-3.5 text-fg">{text}</p>
</section>

<style>
  .gallery-prompt {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 15px;
    line-height: 1.65;
  }
  /* Chinese uses the system fonts; no web font is loaded for it. */
  .gallery-prompt:lang(zh) {
    font-family: system-ui, -apple-system, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
      'Noto Sans CJK SC', 'Source Han Sans SC', sans-serif;
  }
</style>
