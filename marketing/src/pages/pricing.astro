---
import Layout from '../layouts/Layout.astro';

const title = 'Pricing — Godance';
const description =
  'Pass-through provider pricing plus a flat 5% platform fee. No tiers, no seats, no ' +
  'subscriptions. Top up with card, ACH, SEPA, or USDC and spend across every model.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://godance.ai/' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://godance.ai/pricing' },
  ],
};

const rows = [
  { model: 'gpt-4o-mini',                    provider: 'OpenAI',           modality: 'Text',  list: '$0.15 / $0.60 per 1M',  godance: '$0.16 / $0.63 per 1M' },
  { model: 'gpt-4o',                         provider: 'OpenAI',           modality: 'Text',  list: '$2.50 / $10.00 per 1M', godance: '$2.63 / $10.50 per 1M' },
  { model: 'claude-3-5-sonnet-20241022',     provider: 'Anthropic',        modality: 'Text',  list: '$3.00 / $15.00 per 1M', godance: '$3.15 / $15.75 per 1M' },
  { model: 'gemini-1.5-flash',               provider: 'Google',           modality: 'Text',  list: '$0.075 / $0.30 per 1M', godance: '$0.079 / $0.32 per 1M' },
  { model: 'gpt-image-1',                    provider: 'OpenAI',           modality: 'Image', list: '$0.04 / image',         godance: '$0.042 / image' },
  { model: 'flux-1.1-pro',                   provider: 'Black Forest Labs', modality: 'Image', list: '$0.04 / image',         godance: '$0.042 / image' },
  { model: 'sora-2',                         provider: 'OpenAI',           modality: 'Video', list: '$0.15 / second',        godance: '$0.158 / second' },
  { model: 'seedance-1.0',                   provider: 'Volcengine Ark',   modality: 'Video', list: '$0.08 / second',        godance: '$0.084 / second' },
];
---

<Layout {title} {description} canonicalPath="/pricing" jsonLd={[breadcrumb]}>
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-fg">
      One number. Pinned to the floor.
    </h1>
    <p class="mt-6 text-lg text-fg-muted">
      Pay the provider's list price plus a flat <strong class="text-fg">5% platform fee</strong>.
      Same percentage on text, image, and video. No tiers, no seats, no subscriptions, no
      minimums — top up once, spend across every model.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <div class="grid md:grid-cols-2 gap-6">
      <div class="card">
        <h2 class="text-xl font-semibold text-fg">Pay-as-you-go</h2>
        <p class="text-3xl font-bold mt-3 text-fg">
          Provider price <span class="text-fg-subtle text-base font-medium">+ 5%</span>
        </p>
        <p class="mt-2 text-sm text-fg-faint">For everyone, by default.</p>
        <ul class="mt-6 space-y-2 text-fg-muted">
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Every text, image, video, and audio model</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Streaming chat + signed async webhooks</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Fallback chains, region-aware routing</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> 7-day signed URL TTL on generated outputs</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> No minimum, no contract, no commitment</li>
        </ul>
      </div>
      <div class="card" style="border: 2px solid var(--color-primary)">
        <h2 class="text-xl font-semibold text-fg">Enterprise</h2>
        <p class="text-3xl font-bold mt-3 text-fg">Talk to us</p>
        <p class="mt-2 text-sm text-fg-faint">For volume, SLAs, or your own provider keys.</p>
        <ul class="mt-6 space-y-2 text-fg-muted">
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Volume discounts on the platform fee</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Bring your own provider API keys</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Uptime SLA + dedicated incident contact</li>
          <li class="flex gap-2"><span style="color: var(--color-primary)">✓</span> Procurement + DPA workflows</li>
        </ul>
        <a href="mailto:hello@godance.ai" class="mt-6 inline-block font-semibold hover:underline"
           style="color: var(--color-primary)">
          Email hello@godance.ai →
        </a>
      </div>
    </div>

    <h2 class="text-2xl font-bold mt-16 mb-2 text-fg">What that actually costs</h2>
    <p class="text-fg-muted mb-6">
      A sample of model rates — provider list price (left) and what you'd pay through Godance
      (right). Full catalog on <a href="/models" class="underline" style="color: var(--color-primary)">/models</a>.
    </p>
    <div class="card overflow-hidden p-0">
      <table class="w-full text-left text-sm">
        <thead class="bg-bg-muted text-fg-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Model</th>
            <th class="px-4 py-3 font-semibold">Provider</th>
            <th class="px-4 py-3 font-semibold">Modality</th>
            <th class="px-4 py-3 font-semibold text-right">Provider price</th>
            <th class="px-4 py-3 font-semibold text-right">Godance price</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {rows.map((r) => (
            <tr>
              <td class="px-4 py-3 font-mono text-fg">{r.model}</td>
              <td class="px-4 py-3 text-fg-muted">{r.provider}</td>
              <td class="px-4 py-3 text-fg-muted">{r.modality}</td>
              <td class="px-4 py-3 text-right text-fg-muted">{r.list}</td>
              <td class="px-4 py-3 text-right font-medium text-fg">{r.godance}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-xs text-fg-faint">
      Rates track providers — when they change theirs, we change ours. Current prices live on
      <a href="/models" class="underline">/models</a>; this table verified May 2026.
    </p>
  </section>
</Layout>
