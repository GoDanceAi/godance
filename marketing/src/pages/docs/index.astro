---
import Layout from '../../layouts/Layout.astro';
import { loadGallery } from '../../lib/gallery-recipes';

// What the API says about recipes is shown only while the gallery is switched
// on: with it off, nothing on the site mentions it.
const recipesOn = (await loadGallery()).on;

const title = 'Docs — Godance';
const description =
  'Documentation for the Godance OpenAI-compatible API: authentication, chat completions, ' +
  'image and video generation, webhooks, billing.';

// Endpoint reference — each entry links to its section further down this page.
const endpoints = [
  { id: 'chat-completions', label: 'POST /v1/chat/completions', summary: 'streaming + non-streaming' },
  { id: 'images', label: 'POST /v1/images/generations', summary: 'async: returns a job_id to poll, or pass webhook_url' },
  { id: 'videos', label: 'POST /v1/videos/generations', summary: 'async-only, signed webhook' },
  { id: 'jobs', label: 'GET /v1/jobs/{id}', summary: 'async job status, outputs, history and saving a job' },
  { id: 'recipes', label: 'CRUD /v1/recipes', summary: 'keep a prompt template with variables, run it, and total what its attempts cost' },
  { id: 'estimates', label: 'POST /v1/estimates', summary: 'price an image or video request before sending it' },
  { id: 'models', label: 'GET /v1/models', summary: 'catalog, prices and what each model accepts' },
  { id: 'keys', label: 'CRUD /v1/keys', summary: 'API key management' },
  { id: 'billing', label: 'POST /v1/billing/topup', summary: 'credit top-up via Stripe Checkout' },
  { id: 'webhooks', label: 'GET /v1/webhooks/secret', summary: 'signing secret + verification guide' },
];

const chatSnippet = `curl https://api.godance.ai/v1/chat/completions \\
  -H "Authorization: Bearer $GODANCE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "gpt-4o-mini",
    "messages": [{"role": "user", "content": "Hello"}],
    "stream": true
  }'`;

const imageSnippet = `curl https://api.godance.ai/v1/images/generations \\
  -H "Authorization: Bearer $GODANCE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "flux-2-pro",
    "prompt": "a lighthouse at dusk, watercolor",
    "n": 1,
    "webhook_url": "https://example.com/hooks/godance"
  }'`;

const acceptedSnippet = `HTTP/1.1 202 Accepted

{
  "job_id": "6f1c0b9e-2d4a-4c3b-9a57-0e8d4b2f7c11",
  "status": "QUEUED",
  "poll_url": "/v1/jobs/6f1c0b9e-2d4a-4c3b-9a57-0e8d4b2f7c11"
}`;

const jobSnippet = `{
  "id": "6f1c0b9e-2d4a-4c3b-9a57-0e8d4b2f7c11",
  "status": "DONE",
  "modality": "IMAGE",
  "model": "gpt-image-2",
  "prompt": "a lighthouse at dusk, watercolor",
  "params": { "size": "1024x1024", "n": 2 },
  "outputs": [
    { "index": 0, "url": "https://…signed…", "contentType": "image/png",
      "sizeBytes": 812345, "revisedPrompt": null },
    { "index": 1, "url": "https://…signed…", "contentType": "image/png",
      "sizeBytes": 798110, "revisedPrompt": null }
  ],
  "outputUrl": "https://…signed…",
  "purged": false,
  "mediaExpiresAt": "2027-02-10T09:00:00Z",
  "saved": false,
  "channel": "API",${recipesOn ? '\n  "galleryRecipe": null,' : ''}
  "estimatedCostCents": 12,
  "actualCostCents": 12,
  …
}`;

const saveSnippet = `# Save a job: its files and prompt are kept past the 90 days
curl -X PUT https://api.godance.ai/v1/jobs/$JOB_ID/saved \\
  -H "Authorization: Bearer $GODANCE_API_KEY"

# Un-save it: the 90 days apply again
curl -X DELETE https://api.godance.ai/v1/jobs/$JOB_ID/saved \\
  -H "Authorization: Bearer $GODANCE_API_KEY"

# How many you have saved, and the most you can
curl https://api.godance.ai/v1/jobs/saved \\
  -H "Authorization: Bearer $GODANCE_API_KEY"

{ "count": 12, "limit": 500 }`;

const recipeSnippet = `curl https://api.godance.ai/v1/recipes \\
  -H "Authorization: Bearer $GODANCE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "title": "Mug on a kitchen shelf",
    "modality": "IMAGE",
    "template": "A {{color}} mug on a {{surface}}, soft morning light",
    "variables": [
      { "name": "color", "default": "red" },
      { "name": "surface", "default": "kitchen shelf" }
    ],
    "model": "gpt-image-2",
    "params": { "size": "1024x1024", "n": 1 }
  }'

{ "id": "…", "title": "Mug on a kitchen shelf", "modality": "IMAGE",${recipesOn ? '\n  "source_gallery_recipe": null,' : ''}
  "created_at": "2026-11-14T09:00:00Z", "updated_at": "2026-11-14T09:00:00Z",
  "latest_version": {
    "id": "…", "number": 1,
    "template": "A {{color}} mug on a {{surface}}, soft morning light",
    "variables": [
      { "name": "color", "default": "red" },
      { "name": "surface", "default": "kitchen shelf" }
    ],
    "model": "gpt-image-2", "params": { "size": "1024x1024", "n": 1 },
    "created_at": "2026-11-14T09:00:00Z" },
  "attempts": 0, "spent_cents": 0 }`;

const recipeRunSnippet = `curl https://api.godance.ai/v1/images/generations \\
  -H "Authorization: Bearer $GODANCE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "gpt-image-2",
    "size": "1024x1024",
    "recipe": { "version_id": "…", "variables": { "color": "blue" } }
  }'

# The job's prompt is the template with the values filled in
{ "id": "…", "status": "DONE",
  "prompt": "A blue mug on a kitchen shelf, soft morning light",
  "recipe": { "id": "…", "version": 1,
              "variables": { "color": "blue", "surface": "kitchen shelf" } },
  … }`;

const estimateSnippet = `curl https://api.godance.ai/v1/estimates \\
  -H "Authorization: Bearer $GODANCE_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{ "model": "flux-1.1-pro", "n": 1, "size": "1024x1024" }'

{ "model": "flux-1.1-pro", "modality": "IMAGE", "n": 1, "seconds": null,
  "estimated_cost_cents": 4, "currency": "USD" }`;

const capabilitiesSnippet = `"godance": {
  "modality": "VIDEO",
  "display_name": "Runway Gen-4",
  "description": "Runway's Gen-4 text-to-video model. One clip per request.",
  "capabilities": { "default_size": "1280x720", "default_seconds": 5, "max_n": 1 },
  …
}`;

const verifySnippet = `import hmac, hashlib

def verify(payload, header, secret):
    t = int(header.split(',')[0][2:])
    sigs = [p[3:] for p in header.split(',') if p.startswith('v1=')]
    expected = hmac.new(
        secret.encode(), f"{t}.{payload}".encode(),
        hashlib.sha256
    ).hexdigest()
    return any(hmac.compare_digest(expected, s) for s in sigs)`;
---

<Layout {title} {description} canonicalPath="/docs">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-fg">Docs</h1>
    <p class="mt-4 text-fg-muted">
      Godance is an OpenAI-compatible REST API. If you've shipped against the OpenAI SDK,
      you already know the request shape of every endpoint below, and chat is drop-in: same
      JSON, same streaming format. Image and video generation run as async jobs, and errors
      come back as RFC 7807 problem details; see
      <a href="#openai-compat" class="underline" style="color: var(--color-primary)">OpenAI SDK compatibility</a>.
    </p>

    <h2 class="text-2xl font-bold mt-12 mb-4 text-fg">Get to first call in three steps</h2>
    <ol class="space-y-3 list-decimal list-inside text-fg-muted">
      <li>
        <a href="https://app.godance.ai/signup" class="underline" style="color: var(--color-primary)">Create an account</a>
        and mint an API key in Settings → API Keys (returned in plaintext once — save it).
      </li>
      <li>Top up with card, ACH, or SEPA (Stripe), or USDT (NOWPayments). Same balance, same API.</li>
      <li>
        Point your OpenAI SDK at
        <code class="code-chip">https://api.godance.ai/v1</code>
        and start switching <code class="code-chip">model</code> values.
      </li>
    </ol>

    <h2 class="text-2xl font-bold mt-12 mb-4 text-fg">Endpoint reference</h2>
    <ul class="space-y-2 text-fg-muted">
      {endpoints.map(({ id, label, summary }) => (
        <li><a href={`#${id}`} class="underline" style="color: var(--color-primary)">{label}</a> — {summary}</li>
      ))}
    </ul>

    <!-- ===== Chat completions ===== -->
    <h2 id="chat-completions" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">POST /v1/chat/completions</h2>
    <p class="text-fg-muted">
      OpenAI's chat completions contract. Set <code class="code-chip">"stream": true</code>
      for server-sent events; otherwise the response is a single JSON object.
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">model</code> (required) — any text model from the <a href="/models" class="underline" style="color: var(--color-primary)">model catalog</a>.</li>
      <li><code class="code-chip">messages</code> (required) — array of objects with <code class="code-chip">role</code> and <code class="code-chip">content</code>; <code class="code-chip">content</code> is a plain string.</li>
      <li><code class="code-chip">max_tokens</code>, <code class="code-chip">temperature</code> — optional.</li>
      <li><code class="code-chip">stream</code> — optional, defaults to <code class="code-chip">false</code>.</li>
    </ul>
    <p class="mt-4 text-fg-muted">
      Non-streaming returns <code class="code-chip">200</code> with a
      <code class="code-chip">chat.completion</code> object
      (<code class="code-chip">choices[].message</code>, <code class="code-chip">finish_reason</code>,
      <code class="code-chip">usage</code>). Streaming returns
      <code class="code-chip">text/event-stream</code>: one
      <code class="code-chip">chat.completion.chunk</code> per event, then
      <code class="code-chip">data: [DONE]</code>. Other OpenAI parameters
      (<code class="code-chip">tools</code>, <code class="code-chip">top_p</code>,
      <code class="code-chip">response_format</code>, …) aren't supported and are ignored.
    </p>
    <pre class="code-block mt-4"><code>{chatSnippet}</code></pre>

    <!-- ===== Images ===== -->
    <h2 id="images" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">POST /v1/images/generations</h2>
    <p class="text-fg-muted">
      The request shape is OpenAI's. Every image model runs as an async job, so this endpoint
      always answers <code class="code-chip">202 Accepted</code> with a
      <code class="code-chip">job_id</code> — it never returns image data inline. Poll
      <a href="#jobs" class="underline" style="color: var(--color-primary)"><code class="code-chip">GET /v1/jobs/&#123;id&#125;</code></a>
      for the result, or pass <code class="code-chip">webhook_url</code> and receive a
      <a href="#webhooks" class="underline" style="color: var(--color-primary)">signed POST</a>
      when the images are ready.
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">model</code>, <code class="code-chip">prompt</code> (required).</li>
      <li><code class="code-chip">size</code>, <code class="code-chip">n</code>, <code class="code-chip">style</code>, <code class="code-chip">quality</code> — optional, as in OpenAI's API; <code class="code-chip">n</code> defaults to 1.</li>
      <li><code class="code-chip">n</code> can be at most the model's <code class="code-chip">max_n</code> (see <a href="#models" class="underline" style="color: var(--color-primary)">GET /v1/models</a>; 1 when a model doesn't state one). A larger <code class="code-chip">n</code> answers <code class="code-chip">400</code> before anything is reserved.</li>
      <li><code class="code-chip">webhook_url</code> — optional Godance extension; where to POST the completion event.</li>
    </ul>
    <p class="mt-4 text-fg-muted">
      The full cost (per-image price × <code class="code-chip">n</code>) is reserved from your
      balance when the job is accepted and refunded automatically if generation fails. A model
      that returns fewer images than <code class="code-chip">n</code> is charged for the images it
      returned, and the rest of the reservation goes back to your balance. An insufficient
      balance returns <code class="code-chip">402</code>.
    </p>
    <pre class="code-block mt-4"><code>{imageSnippet}</code></pre>
    <pre class="code-block mt-4"><code>{acceptedSnippet}</code></pre>

    <!-- ===== Videos ===== -->
    <h2 id="videos" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">POST /v1/videos/generations</h2>
    <p class="text-fg-muted">
      Always async — video takes minutes, longer than an HTTP request should wait. The response
      is the same <code class="code-chip">202</code> + <code class="code-chip">job_id</code> body
      as for images; poll the job or pass <code class="code-chip">webhook_url</code>.
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">model</code>, <code class="code-chip">prompt</code> (required).</li>
      <li><code class="code-chip">size</code> — optional output resolution.</li>
      <li><code class="code-chip">seconds</code> — optional clip length. Left out, the model's standard length is used: 5 seconds for most models, 10 for the Sora models and 6 for <code class="code-chip">minimax-hailuo-2.3</code>.</li>
      <li><code class="code-chip">n</code> — optional number of clips, defaults to 1. Every video model returns one clip per request today (<code class="code-chip">max_n</code> 1), so a larger <code class="code-chip">n</code> answers <code class="code-chip">400</code> before anything is reserved.</li>
      <li><code class="code-chip">webhook_url</code> — optional; where to POST the completion event.</li>
    </ul>
    <p class="mt-4 text-fg-muted">
      Cost is the model's per-second rate × clip length × <code class="code-chip">n</code>,
      reserved up front and refunded if generation fails. Send <code class="code-chip">seconds</code>
      to fix both the length and the price. A model that returns fewer clips than
      <code class="code-chip">n</code> is charged for the clips it returned. To see the price
      first, send the same fields to
      <a href="#estimates" class="underline" style="color: var(--color-primary)"><code class="code-chip">POST /v1/estimates</code></a>.
    </p>

    <!-- ===== Jobs ===== -->
    <h2 id="jobs" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">GET /v1/jobs/&#123;id&#125;</h2>
    <p class="text-fg-muted">
      Returns one async job: its status, what was asked for and every file it produced. A job
      ID that isn't yours returns <code class="code-chip">404</code>. Fields are camelCase:
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">status</code> — <code class="code-chip">QUEUED</code> → <code class="code-chip">RUNNING</code> → <code class="code-chip">DONE</code> or <code class="code-chip">FAILED</code>.</li>
      <li><code class="code-chip">prompt</code>, <code class="code-chip">params</code> — the request, with its own field names: <code class="code-chip">size</code>, <code class="code-chip">n</code>, <code class="code-chip">style</code>, <code class="code-chip">quality</code> for images; <code class="code-chip">size</code>, <code class="code-chip">seconds</code>, <code class="code-chip">n</code> for video (<code class="code-chip">seconds</code> is the length generated, also when you left it out).</li>
      <li><code class="code-chip">outputs</code> — every file, in order: <code class="code-chip">index</code>, <code class="code-chip">url</code>, <code class="code-chip">contentType</code>, <code class="code-chip">sizeBytes</code>, <code class="code-chip">revisedPrompt</code> (null unless the model rewrote the prompt). Empty until the job is <code class="code-chip">DONE</code>. Each <code class="code-chip">url</code> is signed when you read the job and expires after a while, so read the job again for a fresh link rather than storing one.</li>
      <li><code class="code-chip">outputUrl</code> — the first output's link, signed the same way. Kept for clients written before <code class="code-chip">outputs</code>.</li>
      <li><code class="code-chip">mediaExpiresAt</code> — when the files and prompt are due to be deleted: 90 days after the job was created. Copy anything you want to keep before then, or <a href="#saving-a-job" class="underline" style="color: var(--color-primary)">save the job</a>. Null means nothing is scheduled, which is the case for a saved job.</li>
      <li><code class="code-chip">saved</code> — true when you have saved the job, which keeps its files and prompt past the 90 days.</li>
      <li><code class="code-chip">channel</code> — how the job was made: <code class="code-chip">API</code> with an API key, <code class="code-chip">STUDIO</code> from the web app. Godance sets it from the credentials the request used; no request field changes it. Null on a job made before this was recorded.</li>
      {recipesOn && (
        <li><code class="code-chip">galleryRecipe</code> — the slug of the gallery recipe the job was a run of, or null. To set it, send <code class="code-chip">gallery_recipe</code> in the body of <code class="code-chip">POST /v1/images/generations</code> or <code class="code-chip">POST /v1/videos/generations</code>: a recipe's slug, which is lowercase letters, digits and hyphens, at most 80 characters. Any other value returns <code class="code-chip">400</code> with <code class="code-chip">code: "invalid_gallery_recipe"</code> and nothing is charged. It is optional and changes nothing about the result or its price.</li>
      )}
      <li><code class="code-chip">recipe</code> — set when the job ran one of <a href="#recipes" class="underline" style="color: var(--color-primary)">your recipes</a>: the recipe's <code class="code-chip">id</code>, the <code class="code-chip">version</code> number it ran, and <code class="code-chip">variables</code>, the value each variable had. Null for a job made from a plain prompt, and again once that recipe is deleted.</li>
      <li><code class="code-chip">purged</code> — true once the files and prompt have been deleted; <code class="code-chip">prompt</code> is then null, <code class="code-chip">params</code> is <code class="code-chip">&#123;&#125;</code> and <code class="code-chip">outputs</code> is empty. A <code class="code-chip">recipe</code>'s <code class="code-chip">variables</code> is null too: the values are deleted with the prompt. The cost fields and <code class="code-chip">channel</code> stay{recipesOn && <>, and so does <code class="code-chip">galleryRecipe</code></>}.</li>
      <li><code class="code-chip">errorMessage</code> — set when <code class="code-chip">FAILED</code>; the reserved credit is refunded.</li>
      <li><code class="code-chip">estimatedCostCents</code>, <code class="code-chip">actualCostCents</code> — integer cents: the amount reserved when the job was accepted, and the amount charged once it is <code class="code-chip">DONE</code>.</li>
      <li><code class="code-chip">id</code>, <code class="code-chip">modality</code>, <code class="code-chip">provider</code>, <code class="code-chip">model</code>, <code class="code-chip">createdAt</code>, <code class="code-chip">startedAt</code>, <code class="code-chip">completedAt</code> — timestamps are ISO 8601.</li>
    </ul>
    <pre class="code-block mt-4"><code>{jobSnippet}</code></pre>
    <p class="mt-4 text-fg-muted">
      <code class="code-chip">GET /v1/jobs</code> returns your jobs as a JSON array of the same
      objects, newest first. Without parameters it returns all of them. Optional query
      parameters:
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">limit</code> — 1 to 100 jobs per page.</li>
      <li><code class="code-chip">before</code> — a job <code class="code-chip">id</code>: only jobs older than it. Pass the last <code class="code-chip">id</code> of a page to get the next one; an empty array means there are no more. An <code class="code-chip">id</code> that isn't one of your jobs returns <code class="code-chip">400</code>.</li>
      <li><code class="code-chip">modality</code> — <code class="code-chip">IMAGE</code> or <code class="code-chip">VIDEO</code>.</li>
      <li><code class="code-chip">status</code> — <code class="code-chip">QUEUED</code>, <code class="code-chip">RUNNING</code>, <code class="code-chip">DONE</code> or <code class="code-chip">FAILED</code>.</li>
      <li><code class="code-chip">saved</code> — <code class="code-chip">true</code> for only the jobs you have saved, <code class="code-chip">false</code> for only the others. It combines with the parameters above.</li>
      <li><code class="code-chip">recipe</code> — a recipe <code class="code-chip">id</code>: only the jobs that ran a version of that recipe.</li>
    </ul>

    <h3 id="saving-a-job" class="scroll-mt-24 text-xl font-semibold mt-10 mb-4 text-fg">Saving a job</h3>
    <p class="text-fg-muted">
      A job's files and prompt are deleted 90 days after it was created. Save a job to keep
      them: a saved job is kept until you un-save it or close your account. Saving costs
      nothing and changes nothing about what the job was charged. Works with an API key or a
      signed-in session.
    </p>
    <pre class="code-block mt-4"><code>{saveSnippet}</code></pre>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">PUT</code> and <code class="code-chip">DELETE /v1/jobs/&#123;id&#125;/saved</code> return <code class="code-chip">204</code> with no body. Both are safe to repeat: saving a job that is already saved, or un-saving one that isn't, changes nothing. A job ID that isn't yours returns <code class="code-chip">404</code>.</li>
      <li>Only a <code class="code-chip">DONE</code> job whose files still exist can be saved. Any other job returns <code class="code-chip">409</code> with <code class="code-chip">code: "job_not_saveable"</code>.</li>
      <li>An account can save up to 500 jobs. Saving one more returns <code class="code-chip">409</code> with <code class="code-chip">code: "saved_limit_reached"</code>; un-save a job to make room. <code class="code-chip">GET /v1/jobs/saved</code> returns how many you have saved and your limit.</li>
      <li>While a job is saved, its <code class="code-chip">mediaExpiresAt</code> is null. Un-saving puts the 90 days back, counted from when the job was created. A job already older than that then has a <code class="code-chip">mediaExpiresAt</code> in the past, and its files and prompt are deleted at the next nightly clean-up.</li>
    </ul>

    <!-- ===== Recipes ===== -->
    <h2 id="recipes" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">CRUD /v1/recipes</h2>
    <p class="text-fg-muted">
      A recipe keeps a setup that works: a prompt template with variables, the model and the
      request parameters. Every change you save is a new version, numbered 1, 2, 3…, and a
      version never changes once it is written. Run a version with different values and
      Godance fills the template in, records which version and values each job used, and adds
      up what the attempts cost. Recipes are private to your account: an ID that isn't yours
      returns <code class="code-chip">404</code>. Works with an API key or a signed-in session.
      Field names are snake_case.
    </p>
    <pre class="code-block mt-4"><code>{recipeSnippet}</code></pre>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">POST /v1/recipes</code> — creates a recipe with its version 1 and returns it with <code class="code-chip">201</code>. <code class="code-chip">title</code> (up to 200 characters), <code class="code-chip">modality</code> (<code class="code-chip">IMAGE</code> or <code class="code-chip">VIDEO</code>), <code class="code-chip">template</code> and <code class="code-chip">model</code> are required; <code class="code-chip">variables</code> and <code class="code-chip">params</code> are optional.{recipesOn && <> <code class="code-chip">source_gallery_recipe</code> is optional too: the slug of the gallery recipe yours was made from.</>} A body that breaks a rule on this page returns <code class="code-chip">400</code> with <code class="code-chip">code: "invalid_recipe"</code> and a sentence saying which.</li>
      <li><code class="code-chip">GET /v1/recipes</code> — your recipes as a JSON array, newest first. <code class="code-chip">limit</code> is 1 to 100 per page, and <code class="code-chip">before</code> is a recipe <code class="code-chip">id</code>: only recipes older than it.</li>
      <li><code class="code-chip">GET /v1/recipes/&#123;id&#125;</code> — one recipe, with its latest version.</li>
      <li><code class="code-chip">PATCH /v1/recipes/&#123;id&#125;</code> — renames it: send <code class="code-chip">&#123; "title": "…" &#125;</code>. The title is the only thing about a recipe that changes in place.</li>
      <li><code class="code-chip">DELETE /v1/recipes/&#123;id&#125;</code> — deletes the recipe and its versions, with <code class="code-chip">204</code>. The jobs made with it are kept, and their <code class="code-chip">recipe</code> becomes null.</li>
      <li><code class="code-chip">GET /v1/recipes/&#123;id&#125;/versions</code> — every version, newest first.</li>
      <li><code class="code-chip">POST /v1/recipes/&#123;id&#125;/versions</code> — send <code class="code-chip">template</code>, <code class="code-chip">variables</code>, <code class="code-chip">model</code> and <code class="code-chip">params</code>. When any of them differs from the latest version, a new version is written and returned with <code class="code-chip">201</code>. When nothing differs, the latest version comes back with <code class="code-chip">200</code> and no version is written, so saving twice is safe.</li>
      <li><code class="code-chip">attempts</code> is how many jobs ran any version of the recipe. <code class="code-chip">spent_cents</code> is what the finished ones were charged, in integer cents.</li>
      <li>An account can keep up to 500 recipes, and a recipe up to 200 versions. Past either, the request returns <code class="code-chip">409</code> with <code class="code-chip">code: "recipe_limit_reached"</code>.</li>
    </ul>

    <h3 id="recipe-templates" class="scroll-mt-24 text-xl font-semibold mt-10 mb-4 text-fg">Templates</h3>
    <ul class="space-y-2 text-fg-muted">
      <li>A variable is written <code class="code-chip">&#123;&#123;name&#125;&#125;</code>. A name is 1 to 40 ASCII letters, digits, spaces, hyphens or underscores, and starts and ends with a letter or digit.</li>
      <li>Each variable is declared in <code class="code-chip">variables</code> with its <code class="code-chip">name</code> and a <code class="code-chip">default</code>, which may be an empty string. Every declared variable has to appear in the template at least once.</li>
      <li>Every <code class="code-chip">&#123;&#123;</code> in the template has to begin a declared variable. A <code class="code-chip">&#125;&#125;</code> on its own is ordinary text, so a prompt written as JSON works.</li>
      <li>Filling in replaces each <code class="code-chip">&#123;&#123;name&#125;&#125;</code> with the value you send, or with the default when you send none. An empty string is a value. It is one pass: a value that itself contains <code class="code-chip">&#123;&#123;…&#125;&#125;</code> is inserted as it is.</li>
      <li>A template is at most 32,000 characters and has at most 20 variables. A default or a value is at most 2,000 characters.</li>
    </ul>

    <h3 id="running-a-recipe" class="scroll-mt-24 text-xl font-semibold mt-10 mb-4 text-fg">Running a recipe</h3>
    <p class="text-fg-muted">
      <code class="code-chip">POST /v1/images/generations</code> and
      <code class="code-chip">POST /v1/videos/generations</code> take
      <code class="code-chip">recipe</code> in place of <code class="code-chip">prompt</code>: a
      <code class="code-chip">version_id</code>, and <code class="code-chip">variables</code>
      with a value for any of the version's variables.
    </p>
    <pre class="code-block mt-4"><code>{recipeRunSnippet}</code></pre>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li>Send <code class="code-chip">prompt</code> or <code class="code-chip">recipe</code>, never both: both returns <code class="code-chip">400</code> with <code class="code-chip">code: "prompt_and_recipe"</code>.</li>
      <li>The filled-in template is the job's prompt. It is what the model receives and what <code class="code-chip">prompt</code> shows on the job, and the request costs what the same prompt sent directly would cost.</li>
      <li><code class="code-chip">model</code> and the other request fields are sent as usual. The version's <code class="code-chip">model</code> and <code class="code-chip">params</code> record what worked; they do not limit what you send.</li>
      <li>A <code class="code-chip">version_id</code> that isn't one of your recipes' returns <code class="code-chip">404</code> with <code class="code-chip">code: "recipe_not_found"</code>. An image recipe sent to the video endpoint, or the other way round, returns <code class="code-chip">400</code> with <code class="code-chip">recipe_modality_mismatch</code>; a value for a variable the version doesn't declare returns <code class="code-chip">400</code> with <code class="code-chip">recipe_variable_unknown</code>; a value over 2,000 characters returns <code class="code-chip">400</code> with <code class="code-chip">recipe_variable_too_long</code>. Nothing is charged for a request that is refused.</li>
      <li>The job's <code class="code-chip">recipe</code> then names the recipe, the version and the values used, and <code class="code-chip">GET /v1/jobs?recipe=&#123;id&#125;</code> lists every job that ran the recipe.</li>
    </ul>

    <!-- ===== Estimates ===== -->
    <h2 id="estimates" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">POST /v1/estimates</h2>
    <p class="text-fg-muted">
      The price of an image or video request before you send it. Nothing is charged and no job
      is created. Send the fields that set the price, with the same names as the generation
      request: <code class="code-chip">model</code> (required), <code class="code-chip">n</code>,
      <code class="code-chip">size</code> and, for video, <code class="code-chip">seconds</code>.
      <code class="code-chip">estimated_cost_cents</code> is exactly what the same generation
      request would reserve, with <code class="code-chip">n</code> and
      <code class="code-chip">seconds</code> filled in as the job would fill them
      (<code class="code-chip">seconds</code> is null for images). An unknown model returns
      <code class="code-chip">404</code>; a text model, or an <code class="code-chip">n</code>
      above the model's <code class="code-chip">max_n</code>, returns
      <code class="code-chip">400</code>. Works with an API key or a signed-in session.
    </p>
    <pre class="code-block mt-4"><code>{estimateSnippet}</code></pre>

    <!-- ===== Models ===== -->
    <h2 id="models" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">GET /v1/models</h2>
    <p class="text-fg-muted">
      OpenAI's model list, public, no key needed. Each entry carries a
      <code class="code-chip">godance</code> object with its modality, list price
      (<code class="code-chip">pricing</code>) and platform fee
      (<code class="code-chip">markup_percent</code>). Image and video models may also carry:
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">display_name</code>, <code class="code-chip">description</code> — for showing the model to people.</li>
      <li><code class="code-chip">capabilities</code> — what the model accepts: <code class="code-chip">sizes</code>, <code class="code-chip">default_size</code>, <code class="code-chip">durations</code>, <code class="code-chip">default_seconds</code> (the length used when a video request leaves out <code class="code-chip">seconds</code>) and <code class="code-chip">max_n</code> (the most outputs one request can ask for). Each key is optional, and a missing one means not known, not unlimited. A model without <code class="code-chip">max_n</code> allows 1. <code class="code-chip">sizes</code> and <code class="code-chip">durations</code> are guidance; requests are not rejected on them.</li>
    </ul>
    <pre class="code-block mt-4"><code>{capabilitiesSnippet}</code></pre>

    <!-- ===== API keys ===== -->
    <h2 id="keys" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">CRUD /v1/keys</h2>
    <p class="text-fg-muted">
      Send your key as <code class="code-chip">Authorization: Bearer gd_live_…</code>.
      A key calls the model API only: chat completions, image and video generations,
      estimates, jobs and usage. Everything else, these endpoints included, needs a signed-in
      session; a key gets <code class="code-chip">403</code> there.
      Create keys in the dashboard or with these endpoints:
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li>
        <code class="code-chip">POST /v1/keys</code> with <code class="code-chip">name</code>
        (required) and optional <code class="code-chip">scopes</code> →
        <code class="code-chip">201</code> with <code class="code-chip">id</code>,
        <code class="code-chip">name</code>, <code class="code-chip">prefix</code>,
        <code class="code-chip">plaintext</code>, <code class="code-chip">createdAt</code>.
        <code class="code-chip">plaintext</code> is the key itself and is returned only this once.
      </li>
      <li>
        <code class="code-chip">GET /v1/keys</code> → your keys with
        <code class="code-chip">id</code>, <code class="code-chip">name</code>,
        <code class="code-chip">prefix</code>, <code class="code-chip">scopes</code>,
        <code class="code-chip">active</code>, <code class="code-chip">createdAt</code>,
        <code class="code-chip">lastUsedAt</code>, <code class="code-chip">expiresAt</code>.
        Never includes the key.
      </li>
      <li>
        <code class="code-chip">DELETE /v1/keys/&#123;id&#125;</code> → <code class="code-chip">204</code>;
        the key stops working immediately. Unknown IDs return <code class="code-chip">404</code>.
      </li>
    </ul>
    <p class="mt-4 text-fg-muted">
      An unknown, inactive or expired key returns <code class="code-chip">401</code>. A key
      restricted to an IP allowlist returns <code class="code-chip">403</code> from any other
      address.
    </p>

    <!-- ===== Billing ===== -->
    <h2 id="billing" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">POST /v1/billing/topup</h2>
    <p class="text-fg-muted">
      Usage is paid from a prepaid credit balance. A top-up returns a hosted checkout URL;
      the credit lands on your balance once the payment provider confirms the payment.
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li>
        <code class="code-chip">POST /v1/billing/topup</code> with
        <code class="code-chip">amountCents</code> and optional
        <code class="code-chip">save_card</code> → <code class="code-chip">201</code> with
        <code class="code-chip">sessionId</code>, <code class="code-chip">checkoutUrl</code>,
        <code class="code-chip">amountCents</code>. Send the user to
        <code class="code-chip">checkoutUrl</code> (Stripe Checkout).
        <code class="code-chip">save_card: true</code> keeps the card on file for auto-recharge.
      </li>
      <li>
        <code class="code-chip">POST /v1/billing/nowpayments/topup</code> with
        <code class="code-chip">amountCents</code> → same response; the checkout URL is a
        NOWPayments page for paying in USDT.
      </li>
      <li>
        <code class="code-chip">GET</code> / <code class="code-chip">PUT /v1/billing/auto-recharge</code>
        with <code class="code-chip">enabled</code>, <code class="code-chip">threshold_cents</code>,
        <code class="code-chip">topup_cents</code> — top up automatically when the balance falls
        below the threshold. Needs a card saved with <code class="code-chip">save_card</code>
        (<code class="code-chip">409</code> otherwise).
      </li>
    </ul>
    <p class="mt-4 text-fg-muted">
      An amount outside the allowed range returns <code class="code-chip">400</code>; the
      error detail states the range.
    </p>

    <!-- ===== Webhooks ===== -->
    <h2 id="webhooks" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">GET /v1/webhooks/secret</h2>
    <p class="text-fg-muted">
      Image and video jobs submitted with a <code class="code-chip">webhook_url</code> get a
      JSON POST to that URL when they complete. Each account has one signing secret:
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li>
        <code class="code-chip">GET /v1/webhooks/secret</code> →
        <code class="code-chip">secret</code> (<code class="code-chip">whsec_…</code>) and
        <code class="code-chip">header</code> (<code class="code-chip">X-Godance-Signature</code>).
        The secret is created on first call.
      </li>
      <li>
        <code class="code-chip">POST /v1/webhooks/secret/rotate</code> → a new secret. For the
        next 24 hours deliveries are signed with both the new and the previous secret.
      </li>
    </ul>
    <p class="mt-4 text-fg-muted">The delivery body carries:</p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li><code class="code-chip">event</code> — <code class="code-chip">image.generation.completed</code> or <code class="code-chip">video.generation.completed</code>.</li>
      <li><code class="code-chip">jobId</code>, <code class="code-chip">costCents</code>, <code class="code-chip">createdAt</code> (Unix seconds).</li>
      <li><code class="code-chip">images</code> or <code class="code-chip">videos</code> — one object per output, each with a time-limited <code class="code-chip">url</code> (images also carry <code class="code-chip">revisedPrompt</code>).</li>
    </ul>
    <p class="mt-4 text-fg-muted">
      Deliveries are sent once, on success, with a 10-second timeout and no retries. A failed
      job sends no webhook — if one doesn't arrive, poll
      <code class="code-chip">GET /v1/jobs/&#123;id&#125;</code>.
    </p>

    <h3 class="text-xl font-semibold mt-10 mb-4 text-fg">Webhook signature verification</h3>
    <p class="text-fg-muted">
      Outbound webhooks carry an <code class="code-chip">X-Godance-Signature</code>
      header in Stripe format: <code class="code-chip">t=&lt;unix&gt;,v1=&lt;hex&gt;[,v1=&lt;hex&gt;...]</code>.
      Each <code class="code-chip">v1</code> is HMAC-SHA256 of
      <code class="code-chip">&lt;t&gt;.&lt;raw body&gt;</code>, so verify against the raw
      request body before parsing it. During the 24-hour grace window after a secret rotation, two
      <code class="code-chip">v1=</code> entries are included — verify against
      your stored secret and accept on ANY match.
    </p>
    <pre class="code-block mt-4"><code set:html={verifySnippet} /></pre>

    <!-- ===== OpenAI SDK compatibility ===== -->
    <h2 id="openai-compat" class="scroll-mt-24 text-2xl font-bold mt-16 mb-4 text-fg">OpenAI SDK compatibility</h2>
    <p class="text-fg-muted">
      Point the OpenAI SDK at <code class="code-chip">https://api.godance.ai/v1</code> and use
      a Godance key as the API key.
    </p>
    <ul class="mt-4 space-y-2 text-fg-muted">
      <li>
        <strong class="text-fg">Works unchanged:</strong> chat completions, streaming and
        non-streaming, and <code class="code-chip">GET /v1/models</code>. Catalog entries carry an
        extra <code class="code-chip">godance</code> object (modality, list price, platform fee
        and, for image and video models, what the model accepts) that OpenAI clients ignore.
      </li>
      <li>
        <strong class="text-fg">Same request, different response:</strong> image and video
        generation return <code class="code-chip">202</code> + <code class="code-chip">job_id</code>
        instead of the finished output, so the SDK's typed result won't contain images. Call
        these endpoints with a plain HTTP client (or your SDK's raw-response mode) and read
        <code class="code-chip">job_id</code>.
      </li>
      <li>
        <strong class="text-fg">Errors:</strong> non-2xx responses use RFC 7807
        <code class="code-chip">application/problem+json</code> bodies
        (<code class="code-chip">title</code>, <code class="code-chip">status</code>,
        <code class="code-chip">detail</code>) rather than OpenAI's error object. Status codes
        keep their usual meaning — <code class="code-chip">400</code> invalid request,
        <code class="code-chip">401</code> bad key, <code class="code-chip">402</code> insufficient
        credit or spending cap reached, <code class="code-chip">404</code> unknown model or job —
        so SDKs still raise their usual status errors.
      </li>
    </ul>

    <p class="mt-12 text-sm text-fg-subtle">
      Questions?
      <!--email_off--><a href="mailto:hello@godance.ai" class="underline" style="color: var(--color-primary)">Email us</a><!--/email_off-->.
    </p>
