---
import Layout from '../layouts/Layout.astro';

const title = 'Godance — every AI model, one API, drop-in OpenAI compatible';
const description =
  'OpenAI, Anthropic, Sora, Claude, Flux, Gemini, Volcengine Ark — text, image, and video behind one ' +
  'OpenAI-compatible REST API. Swap base_url, ship. Pay with card, ACH, SEPA, or USDT.';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Godance',
  url: 'https://godance.ai',
  description,
  logo: 'https://godance.ai/logo.png',
  sameAs: [],
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Godance API',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web, REST',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'OpenAI-compatible REST API for text, image, and video generation across 15+ upstream providers, ' +
    'with built-in fallback chains, signed webhooks, and a published platform fee ' +
    '(5% on text, 12% on images, 10–15% on video).',
};

const pythonSnippet = `from openai import OpenAI

client = OpenAI(
  base_url="https://api.godance.ai/v1",
  api_key="gd_live_..."
)

# Same SDK. Different model. No code change.
r = client.chat.completions.create(
  model="claude-3-5-sonnet-20241022",
  messages=[{"role": "user", "content": "Hi"}]
)`;

// FAQ — visible on the page AND structured for Google + AI agents.
const faqs = [
  {
    q: 'Will my existing OpenAI SDK code work?',
    a: 'For chat, yes — swap base_url to https://api.godance.ai/v1 and use a Godance API key. /v1/chat/completions (streaming + non-streaming) and /v1/models match OpenAI\'s contract. /v1/images/generations takes OpenAI\'s request shape but runs async: it returns 202 with a job_id, and you fetch the result from GET /v1/jobs/{id} or receive it at a webhook_url. Video generation works the same way.',
  },
  {
    q: 'Which providers and models do you support?',
    a: 'OpenAI (GPT, Sora, gpt-image), Anthropic (Claude), Google Vertex (Gemini, Imagen, Veo), Black Forest Labs (Flux), Volcengine Ark (Doubao, Seedream, Seedance), DeepSeek, Moonshot (Kimi), Alibaba (Qwen), Zhipu (GLM), MiniMax, Baidu (ERNIE), xAI (Grok), Kling, Runway, and Stability. New providers ship as needed — email us.',
  },
  {
    q: 'What does it actually cost?',
    a: 'Provider list price plus a platform fee: 5% on text, 12% on images, and 10–15% on video depending on the model. Every model\'s fee is listed at godance.ai/models. No tiers, no seats, no minimums. Top up the credit ledger; spend it across every model.',
  },
  {
    q: 'What happens when a provider goes down?',
    a: 'Configure a fallback chain per model. When the primary returns a 5xx or times out, Godance transparently retries the next option in the chain — the response carries fallback_used:true so you know what happened.',
  },
  {
    q: 'How do I verify webhook deliveries?',
    a: 'Outbound webhooks carry X-Godance-Signature in Stripe format (t=<unix>,v1=<hex>). Per-user signing secret retrievable at GET /v1/webhooks/secret. After rotation, both old and new signatures are accepted for 24 hours so deployments don\'t drop events.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Provider list anchors trust in the hero. Order: alphabetical inside category.
const providerNames = [
  'OpenAI', 'Anthropic', 'Google Vertex', 'Sora', 'Black Forest Labs',
  'Volcengine Ark', 'DeepSeek', 'Moonshot', 'Qwen', 'Zhipu', 'MiniMax', 'Baidu',
  'xAI', 'Kling', 'Runway', 'Stability',
];
---

<Layout {title} {description} canonicalPath="/" jsonLd={[orgSchema, productSchema, faqSchema]}>

  <!-- ===== Hero ===== -->
  <section class="mx-auto max-w-5xl px-6 pt-24 pb-12 text-center">
    <p class="text-sm font-semibold tracking-wider uppercase" style="color: var(--color-primary)">
      One API. Every model. Text, image, video.
    </p>
    <h1 class="mt-5 text-5xl md:text-6xl font-bold tracking-tight text-fg">
      Build with every AI model.<br class="hidden md:block" />
      Skip the integration tax.
    </h1>
    <p class="mt-6 text-lg md:text-xl text-fg-muted max-w-2xl mx-auto">
      Godance is an OpenAI-compatible API that routes to 15+ providers — OpenAI,
      Anthropic, Sora, Claude, Flux, Gemini, Volcengine Ark, and more. Drop-in for chat;
      image and video run as async jobs. One credit ledger, one billing line, one SDK.
    </p>
    <div class="mt-10 flex items-center justify-center gap-3 flex-wrap">
      <a href="https://app.godance.ai/signup" class="btn btn-primary btn-lg">
        Start free — no card needed
      </a>
      <a href="/docs" class="btn btn-secondary btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v18H6a2 2 0 0 1-2-2zM4 18h15" /></svg>
        Read the docs
      </a>
    </div>
    <p class="mt-6 text-sm text-fg-subtle">
      Pass-through pricing + a published platform fee. Card, ACH, SEPA, or USDT. No subscription.
    </p>
  </section>

  <!-- ===== Provider strip ===== -->
  <section class="border-y border-border bg-bg-muted">
    <div class="mx-auto max-w-6xl px-6 py-8">
      <p class="text-center text-xs font-semibold text-fg-subtle uppercase tracking-widest mb-4">
        Routes to providers including
      </p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-fg">
        {providerNames.map((name) => (
          <li class="font-medium">{name}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Why ===== -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-fg">
          Stop maintaining six SDKs.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          Six provider integrations, six rate-limit dashboards, six invoices, six SDK upgrades
          per quarter. Godance is the one URL that replaces all of them.
        </p>
      </div>

      <div class="mt-16 grid md:grid-cols-3 gap-10">
        <div>
          <h3 class="text-lg font-semibold text-fg">Multimodal from day one</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            Text completions, image generation, video clips, TTS, STT — same auth, same
            billing, same shape. Switching from a Claude chat to a Sora render is one model
            name away.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg">Truly drop-in for OpenAI clients</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            Point the OpenAI SDK at <code class="code-chip">api.godance.ai/v1</code>
            and you're done. Same endpoints, same JSON, same error codes, same streaming format.
            Migrating production is a one-line diff.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg">Pay how your customers pay</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            Card, ACH, and SEPA via Stripe, or USDT via NOWPayments. One credit ledger,
            one balance — top it up once and spend it across every model.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg">Fallback chains, not pager duty</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            Configure per-model fallbacks. Primary 5xx or times out? Godance retries the next
            option, transparently. Response carries <code class="code-chip">fallback_used:true</code>
            so your observability stays honest.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg">Two regions, one DNS</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            DigitalOcean primary, Alibaba Cloud secondary. Cloudflare DNS health-checked
            failover. Per-region provider allowlist enforced in code — your Western-frontier
            calls never route through Alicloud.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-fg">Streaming + signed webhooks</h3>
          <p class="mt-2 text-fg-muted leading-relaxed">
            SSE for chat completions. Async jobs for video and HD images, with Stripe-format
            HMAC-signed callbacks and a 24-hour rotation grace window. Production-grade DX
            with none of the fiddly bits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Code sample ===== -->
  <section class="bg-bg-muted py-24 border-y border-border">
    <div class="mx-auto max-w-6xl px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-fg">
          Less migration, more shipping.
        </h2>
        <p class="mt-4 text-lg text-fg-muted">
          Existing OpenAI SDK code — Python, TypeScript, Java, Go — works without modification.
          Change one URL. Start calling Claude, Gemini, or any other model the next request.
        </p>
        <p class="mt-4 text-sm text-fg-subtle">
          Same idiom for <code class="code-chip">/v1/models</code>. Image and video
          generation take the same request shape but run as async jobs — poll
          <code class="code-chip">/v1/jobs/&#123;id&#125;</code> or get a webhook.
        </p>
      </div>
      <pre class="code-block"><code set:html={pythonSnippet} /></pre>
    </div>
  </section>

  <!-- ===== FAQ (visible — mirrors JSON-LD) ===== -->
  <section class="py-24">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-center text-fg">
        Questions, briefly answered
      </h2>
      <dl class="mt-12 space-y-8">
        {faqs.map((f) => (
          <div>
            <dt class="text-lg font-semibold text-fg">{f.q}</dt>
            <dd class="mt-2 text-fg-muted leading-relaxed">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ===== Closing CTA ===== -->
  <section style="background: var(--color-primary)">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">
        15+ providers. One bill. Ten minutes to first call.
      </h2>
      <p class="mt-4 text-lg" style="color: rgba(255,255,255,0.85)">
        Free to sign up. Free to read the docs. Pay only for what you generate.
      </p>
      <div class="mt-10 flex items-center justify-center gap-3 flex-wrap">
        <a href="https://app.godance.ai/signup" class="btn btn-lg"
           style="background:#fff; color: var(--gd-violet-700);">
          Create an account
        </a>
        <a href="/pricing" class="btn btn-lg"
           style="background:transparent; color:#fff; border:1px solid rgba(255,255,255,0.4);">
          See pricing
        </a>
      </div>
    </div>
  </section>
</Layout>
