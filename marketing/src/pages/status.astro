---
import Layout from '../layouts/Layout.astro';

const title = 'Status — Godance';
const description =
  'Real-time provider availability for Godance. Per-provider, per-model request counts, ' +
  'rate-limit hits, and error rates over the trailing hour.';

// Backend base URL — baked at build time via PUBLIC_API_BASE.
// Default is the local dev server; CI/CD overrides for staging + prod.
const API_BASE = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8080';
---

<Layout {title} {description} canonicalPath="/status">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight">Status</h1>
    <p class="mt-4 text-gray-600 max-w-2xl">
      Live provider availability, request volume, and rate-limit signals — refreshed
      every 30 seconds. If something's wrong upstream, you'll see it here before your
      dashboards do.
    </p>

    <div
      id="status-board"
      class="mt-12"
      data-api-base={API_BASE}
      data-state="loading"
    >
      <p class="text-sm text-gray-500">Loading provider status…</p>
    </div>

    <p class="mt-12 text-xs text-gray-400">
      Latency percentiles will appear here once gateway-level timing is instrumented.
    </p>
  </section>
</Layout>

<script>
  type ProviderRow = {
    provider: string;
    model: string;
    windowStart: string;
    windowEnd: string;
    requestCount: number;
    errorCount: number;
    rateLimitCount: number;
    p50Ms: number | null;
    p95Ms: number | null;
    p99Ms: number | null;
    state: 'ok' | 'degraded' | 'down';
  };
  type StatusResponse = { generatedAt: string; providers: ProviderRow[] };

  const board = document.getElementById('status-board') as HTMLElement | null;
  if (board) {
    const apiBase = board.dataset.apiBase ?? '';
    const STATE_PILL: Record<ProviderRow['state'], string> = {
      ok: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
      degraded: 'bg-amber-50 text-amber-800 ring-amber-200',
      down: 'bg-rose-50 text-rose-700 ring-rose-200',
    };

    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function render(data: StatusResponse): void {
      if (!data.providers.length) {
        board!.innerHTML =
          '<p class="text-sm text-gray-500">No traffic in the past hour. All providers idle.</p>';
        return;
      }
      const rows = data.providers
        .map((p) => `
          <tr class="border-t border-gray-100">
            <td class="py-3 pr-4 font-medium text-gray-900">${esc(p.provider.toLowerCase())}</td>
            <td class="py-3 pr-4 text-gray-700">${esc(p.model)}</td>
            <td class="py-3 pr-4 tabular-nums text-gray-700">${p.requestCount}</td>
            <td class="py-3 pr-4 tabular-nums text-gray-700">${p.errorCount}</td>
            <td class="py-3 pr-4 tabular-nums text-gray-700">${p.rateLimitCount}</td>
            <td class="py-3"><span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs ring-1 ring-inset ${STATE_PILL[p.state]}">${esc(p.state)}</span></td>
          </tr>`)
        .join('');
      board!.innerHTML = `
        <div class="overflow-hidden rounded-lg border border-gray-200">
          <table class="w-full text-sm text-left">
            <thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500">
              <tr>
                <th class="py-2 pl-4 pr-4 font-medium">Provider</th>
                <th class="py-2 pr-4 font-medium">Model</th>
                <th class="py-2 pr-4 font-medium">Requests (5m)</th>
                <th class="py-2 pr-4 font-medium">Errors</th>
                <th class="py-2 pr-4 font-medium">Rate-limits</th>
                <th class="py-2 pr-4 font-medium">State</th>
              </tr>
            </thead>
            <tbody class="bg-white">${rows}</tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-gray-400">Generated ${esc(new Date(data.generatedAt).toLocaleString())}</p>`;
    }

    function renderError(msg: string): void {
      board!.innerHTML =
        `<p class="text-sm text-rose-600">Status feed unreachable: ${esc(msg)}.</p>`;
    }

    async function refresh(): Promise<void> {
      try {
        const r = await fetch(`${apiBase}/v1/status`, { headers: { Accept: 'application/json' } });
        if (!r.ok) {
          renderError(`HTTP ${r.status}`);
          return;
        }
        render(await r.json());
      } catch (e) {
        renderError(e instanceof Error ? e.message : 'network error');
      }
    }

    refresh();
    setInterval(refresh, 30_000);
  }
</script>
