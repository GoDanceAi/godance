---
import Layout from '../layouts/Layout.astro';

const title = 'Status — Godance';
const description =
  'Real-time provider availability for Godance. Per-provider, per-model latency ' +
  'percentiles, error rates, and rate-limit signals over the trailing hour.';

// Backend base URL — baked at build time via PUBLIC_API_BASE.
// Default is the local dev server; CI/CD overrides for staging + prod.
const API_BASE = import.meta.env.PUBLIC_API_BASE ?? 'http://localhost:8080';
---

<Layout {title} {description} canonicalPath="/status">
  <section class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-fg">Status</h1>
    <p class="mt-4 text-fg-muted max-w-2xl">
      Live provider availability, latency percentiles, and error rates — refreshed
      every 30 seconds. If something's wrong upstream, you'll see it here before your
      dashboards do.
    </p>

    <div
      id="status-board"
      class="mt-12"
      data-api-base={API_BASE}
      data-state="loading"
    >
      <p class="text-sm text-fg-subtle">Loading provider status…</p>
    </div>

    <p class="mt-8 text-xs text-fg-faint">
      Latency is measured at the gateway for every upstream call. A model is marked
      <span class="pill pill-amber">degraded</span> when it is rate-limited or its error
      rate climbs, and <span class="pill pill-rose">down</span> when calls are failing
      outright — the configured fallback chain takes over automatically.
    </p>
  </section>
</Layout>

<script>
  type ProviderRow = {
    provider: string;
    model: string;
    windowStart: string;
    windowEnd: string;
    requestCount: number;
    errorCount: number;
    rateLimitCount: number;
    p50Ms: number | null;
    p95Ms: number | null;
    p99Ms: number | null;
    state: 'ok' | 'degraded' | 'down';
  };
  type StatusResponse = { generatedAt: string; providers: ProviderRow[] };

  const board = document.getElementById('status-board') as HTMLElement | null;
  if (board) {
    const apiBase = board.dataset.apiBase ?? '';
    // Map upstream state to a design-system pill class.
    const STATE_PILL: Record<ProviderRow['state'], string> = {
      ok: 'pill-emerald',
      degraded: 'pill-amber',
      down: 'pill-rose',
    };

    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    }

    function ms(v: number | null): string {
      return v == null ? '—' : `${v} ms`;
    }

    // Error rate over the window, with a colour cue past the 10% de-prefer threshold.
    function errorRate(p: ProviderRow): string {
      if (p.requestCount <= 0) return '<span class="text-fg-faint">—</span>';
      const rate = (p.errorCount / p.requestCount) * 100;
      const cls = rate > 10 ? 'text-danger font-semibold' : rate > 0 ? 'text-fg' : 'text-fg-muted';
      return `<span class="${cls}">${rate.toFixed(1)}%</span>`;
    }

    function render(data: StatusResponse): void {
      if (!data.providers.length) {
        board!.innerHTML =
          '<p class="text-sm text-fg-subtle">No traffic in the past hour. All providers idle.</p>';
        return;
      }
      const rows = data.providers
        .map((p) => `
          <tr class="border-t border-border">
            <td class="py-3 pl-4 pr-4 font-medium text-fg">${esc(p.provider.toLowerCase())}</td>
            <td class="py-3 pr-4 font-mono text-fg-muted">${esc(p.model)}</td>
            <td class="py-3 pr-4 tabular-nums text-fg-muted">${p.requestCount}</td>
            <td class="py-3 pr-4 tabular-nums">${errorRate(p)}</td>
            <td class="py-3 pr-4 tabular-nums text-fg-muted">${ms(p.p50Ms)}</td>
            <td class="py-3 pr-4 tabular-nums text-fg-muted">${ms(p.p95Ms)}</td>
            <td class="py-3 pr-4 tabular-nums text-fg-muted">${ms(p.p99Ms)}</td>
            <td class="py-3 pr-4"><span class="pill ${STATE_PILL[p.state]}">${esc(p.state)}</span></td>
          </tr>`)
        .join('');
      board!.innerHTML = `
        <div class="card overflow-hidden p-0">
          <table class="w-full text-sm text-left">
            <thead class="bg-bg-muted text-xs uppercase tracking-wider text-fg-subtle">
              <tr>
                <th class="py-2 pl-4 pr-4 font-medium">Provider</th>
                <th class="py-2 pr-4 font-medium">Model</th>
                <th class="py-2 pr-4 font-medium">Requests (5m)</th>
                <th class="py-2 pr-4 font-medium">Error rate</th>
                <th class="py-2 pr-4 font-medium">p50</th>
                <th class="py-2 pr-4 font-medium">p95</th>
                <th class="py-2 pr-4 font-medium">p99</th>
                <th class="py-2 pr-4 font-medium">State</th>
              </tr>
            </thead>
            <tbody>${rows}</tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-fg-faint">Generated ${esc(new Date(data.generatedAt).toLocaleString())}</p>`;
    }

    function renderError(msg: string): void {
      board!.innerHTML =
        `<p class="text-sm text-danger">Status feed unreachable: ${esc(msg)}.</p>`;
    }

    async function refresh(): Promise<void> {
      try {
        const r = await fetch(`${apiBase}/v1/status`, { headers: { Accept: 'application/json' } });
        if (!r.ok) {
          renderError(`HTTP ${r.status}`);
          return;
        }
        render(await r.json());
      } catch (e) {
        renderError(e instanceof Error ? e.message : 'network error');
      }
    }

    refresh();
    setInterval(refresh, 30_000);
  }
</script>
