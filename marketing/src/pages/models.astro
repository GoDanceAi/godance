---
import Layout from '../layouts/Layout.astro';
import { loadCatalog } from '../lib/catalog';

const title = 'Model catalog — Godance';
const description =
  'Every model available on Godance: OpenAI, Anthropic, Google Vertex, Volcengine Ark, ' +
  'Black Forest Labs, DeepSeek, Moonshot, Alibaba, Zhipu, MiniMax, Baidu, xAI, Kling, ' +
  'Runway, Stability.';

// Catalog is generated at build time from the live GET /v1/models endpoint, so
// this page never drifts from the backend. Falls back to a static snapshot if
// the API is unreachable during the build.
const catalog = await loadCatalog();

// Itemized list for AI-agent consumption (LLMs scraping Markdown-shaped data).
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Godance model catalog',
  numberOfItems: catalog.rows.length,
  itemListElement: catalog.rows.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.id,
    description: `${m.provider} via Godance`,
  })),
};
---

<Layout {title} {description} canonicalPath="/models" jsonLd={[itemList]}>
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-12">
    <h1 class="text-4xl font-bold tracking-tight text-fg">Every model, one URL.</h1>
    <p class="mt-4 text-fg-muted max-w-2xl">
      The full set of models you can call through Godance today, with provider attribution
      and what each one costs. Prices are pass-through plus a flat 5% platform fee — see
      <a href="/pricing" class="underline" style="color: var(--color-primary)">why we charge a single percentage</a>.
      New models arrive as providers ship them.
    </p>
  </section>

  {catalog.groups.map((g) => (
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <h2 class="text-2xl font-bold mb-1 text-fg">{g.label}</h2>
      <p class="text-sm text-fg-subtle mb-4">Prices {g.rows[0].unit}.</p>
      <div class="card overflow-hidden p-0">
        <table class="w-full text-left text-sm">
          <thead class="bg-bg-muted text-fg-subtle">
            <tr>
              <th class="px-4 py-3 font-semibold">Model ID</th>
              <th class="px-4 py-3 font-semibold">Provider</th>
              <th class="px-4 py-3 font-semibold text-right">Provider price</th>
              <th class="px-4 py-3 font-semibold text-right">Godance price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {g.rows.map((m) => (
              <tr>
                <td class="px-4 py-3 font-mono text-fg">
                  {m.id}
                  {m.requiresAsync && (
                    <span class="pill pill-violet ml-2 align-middle">async</span>
                  )}
                </td>
                <td class="px-4 py-3 text-fg-muted">{m.provider}</td>
                <td class="px-4 py-3 text-right text-fg-muted">{m.listPrice}</td>
                <td class="px-4 py-3 text-right font-medium text-fg">{m.godancePrice}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <p class="text-sm text-fg-subtle">
      Need a model that's not here? <a href="mailto:hello@godance.ai" class="underline" style="color: var(--color-primary)">Email us</a> —
      we add providers when there's demand.
    </p>
  </section>
</Layout>
