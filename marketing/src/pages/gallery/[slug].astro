---
/**
 * /gallery/<slug>: one recipe. The output, the prompt in both languages, how
 * it was made, the API call that reproduces it, and who the prompt is by.
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ApiCall from '../../components/gallery/ApiCall.astro';
import PromptBlock from '../../components/gallery/PromptBlock.astro';
import RecipeCard from '../../components/gallery/RecipeCard.astro';
import RecipeInputs from '../../components/gallery/RecipeInputs.astro';
import RunAtScale from '../../components/gallery/RunAtScale.astro';
import RunOutput from '../../components/gallery/RunOutput.astro';
import TemplateBlock from '../../components/gallery/TemplateBlock.astro';
import { slotsOf } from '../../components/gallery/inputs';
import { LICENCE_URLS, recipeJsonLd } from '../../lib/gallery-api';
import {
  GALLERY_PATH,
  excerpt,
  formatCost,
  formatDate,
  formatParam,
  galleryModels,
  isVideoOutput,
  loadGallery,
  mediaUrl,
  modelPath,
  recipePath,
  relatedRecipes,
  scriptJson,
  type Recipe,
} from '../../lib/gallery-recipes';

export const getStaticPaths = (async () => {
  const gallery = await loadGallery();
  return gallery.recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}) satisfies GetStaticPaths;

interface Props {
  recipe: Recipe;
}

const { recipe } = Astro.props;
const { recipes, config } = await loadGallery();
const mediaBase = config.mediaBaseUrl;
const [firstRun, ...otherRuns] = recipe.runs;
const firstOutput = firstRun.outputs[0];
const isVideo = recipe.modality === 'VIDEO';
const related = relatedRecipes(recipe, recipes);
const { source } = recipe;

const title = `${recipe.title.en} — ${firstRun.model} ${isVideo ? 'video' : 'image'} prompt | Godance gallery`;
const description = excerpt(recipe.prompt.en);

// The output is the page's Open Graph image: the image itself, or a video's
// poster. A video without a poster keeps the site's default.
const ogFile = isVideoOutput(firstOutput) ? firstOutput.poster : firstOutput.file;
const ogImage = ogFile ? mediaUrl(mediaBase, ogFile) : undefined;

const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://app.godance.ai';
// Both calls to action say where the visit came from: this recipe's page.
const campaign = `utm_source=godance&utm_medium=gallery&utm_campaign=${encodeURIComponent(recipe.slug)}`;
const runThisUrl = `${appUrl}/create/${isVideo ? 'video' : 'image'}?example=${encodeURIComponent(recipe.slug)}&${campaign}`;
const getKeyUrl = `${appUrl}/signup?${campaign}`;

// A recipe with a template shows it, and its variables with their defaults.
// One published before templates only lists the blanks that were filled.
const template = recipe.prompt.template;
const variables = recipe.prompt.variables ?? [];
const shown = (value: string) => (value === '' ? '(empty)' : value);

// A recipe with inputs shows each slot's sample beside the output, and says
// how each sample was made. A sample's model links to its page only when the
// gallery has one for it: a model page exists for models with a run.
const slots = slotsOf(recipe);
const modelsWithPages = new Set(galleryModels(recipes).map((model) => model.id));

// The source lists are GitHub repositories, named "owner/repo".
const listUrl = /^[\w.-]+\/[\w.-]+$/.test(source.list)
  ? `https://github.com/${source.list}${/^[0-9a-f]{7,40}$/.test(source.list_commit) ? `/tree/${source.list_commit}` : ''}`
  : null;

const contactIsEmail = !/^https?:/i.test(config.removalContact);
const contactHref = contactIsEmail ? `mailto:${config.removalContact}` : config.removalContact;

const link = 'underline';
const linkStyle = 'color: var(--color-primary)';
---

<Layout {title} {description} canonicalPath={recipePath(recipe.slug)} {...(ogImage ? { ogImage } : {})}>
  <article class="mx-auto max-w-5xl px-6 pt-12 pb-20" data-recipe-page={recipe.slug}>
    <p class="text-sm text-fg-subtle">
      <a href={GALLERY_PATH} class="underline hover:text-fg">Gallery</a>
      <span aria-hidden="true"> / </span>{isVideo ? 'Video' : 'Image'}
    </p>

    <h1 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight text-fg">{recipe.title.en}</h1>
    {recipe.title.zh && (
      <p class="mt-1.5 text-xl text-fg-muted" lang="zh-Hans" data-title-zh>{recipe.title.zh}</p>
    )}
    {recipe.tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tags">
        {recipe.tags.map((tag) => (
          <li><a href={`${GALLERY_PATH}?tag=${encodeURIComponent(tag)}`} class="pill">{tag}</a></li>
        ))}
      </ul>
    )}

    <!-- ===== Output ===== -->
    <div class="mt-8">
      {slots.length > 0
        ? <RecipeInputs {recipe} run={firstRun} {mediaBase} eager />
        : <RunOutput {recipe} run={firstRun} {mediaBase} eager />}
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <!-- ===== Prompt ===== -->
      <div class="min-w-0">
        <h2 class="text-2xl font-bold text-fg">Prompt</h2>
        <div class="mt-4 space-y-4">
          <PromptBlock id="prompt-en" heading="English" text={recipe.prompt.en} />
          <PromptBlock
            id="prompt-zh"
            heading="中文"
            text={recipe.prompt.zh}
            lang="zh-Hans"
            note={recipe.prompt.zh_origin === 'machine' ? 'Machine translation' : undefined}
          />
        </div>
        <p class="mt-3 text-sm text-fg-subtle">
          This run sent the {firstRun.prompt_lang === 'zh' ? 'Chinese' : 'English'} prompt.
        </p>

        {template && (
          <section class="mt-8" data-template>
            <h3 class="text-lg font-semibold text-fg">Template</h3>
            <p class="mt-1 text-sm text-fg-muted">
              This prompt has {variables.length === 1 ? 'a blank' : 'blanks'} you can fill in with your own
              {variables.length === 1 ? 'value' : 'values'}. The prompt above is the template with its defaults.
              In the Studio, each variable gets a field of its own.
            </p>
            <div class="mt-3 space-y-4">
              <TemplateBlock id="template-en" heading="English" template={template.en} />
              <TemplateBlock id="template-zh" heading="中文" template={template.zh} lang="zh-Hans" />
            </div>
            <div class="mt-4 card p-0 overflow-x-auto" data-variables>
              <table class="w-full text-sm">
                <thead class="border-b border-border bg-bg-muted text-left text-fg-subtle">
                  <tr>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Variable</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Default</th>
                    <th scope="col" class="px-4 py-2.5 font-semibold">Default in Chinese</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {variables.map((variable) => (
                    <tr data-variable-row={variable.name}>
                      <th scope="row" class="px-4 py-2.5 text-left font-mono font-normal text-fg-subtle">{variable.name}</th>
                      <td class="px-4 py-2.5 text-fg">{shown(variable.default)}</td>
                      <td class="px-4 py-2.5 text-fg" lang={variable.zh_default === undefined ? undefined : 'zh-Hans'}>
                        {variable.zh_default === undefined
                          ? <span class="text-fg-subtle">the same</span>
                          : shown(variable.zh_default)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {!template && variables.length > 0 && (
          <section class="mt-8" data-variables>
            <h3 class="text-lg font-semibold text-fg">Variables</h3>
            <p class="mt-1 text-sm text-fg-muted">
              The original prompt is a template. These are its placeholders, with the values used here.
            </p>
            <dl class="mt-3 card p-0 divide-y divide-border text-sm">
              {variables.map((variable) => (
                <div class="flex flex-wrap gap-x-4 gap-y-1 px-4 py-2.5">
                  <dt class="font-mono text-fg-subtle">{variable.name}</dt>
                  <dd class="text-fg">{shown(variable.default)}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </div>

      <!-- ===== How it was made ===== -->
      <aside>
        <h2 class="text-2xl font-bold text-fg">How it was made</h2>
        <dl class="mt-4 card p-0 divide-y divide-border text-sm" data-run-facts>
          <div class="gallery-fact">
            <dt>Model</dt>
            <dd><a href={modelPath(firstRun.model)} class:list={['font-mono', link]} style={linkStyle}>{firstRun.model}</a></dd>
          </div>
          {Object.entries(firstRun.params).map(([key, value]) => (
            <div class="gallery-fact">
              <dt class="font-mono">{key}</dt>
              <dd class="font-mono">{formatParam(value)}</dd>
            </div>
          ))}
          <div class="gallery-fact">
            <dt>Cost</dt>
            <dd data-cost>{formatCost(firstRun.cost_cents)}</dd>
          </div>
          <div class="gallery-fact">
            <dt>Generated</dt>
            <dd><time datetime={firstRun.generated_on}>{formatDate(firstRun.generated_on)}</time></dd>
          </div>
        </dl>
        <p class="mt-3 text-sm text-fg-subtle">
          The cost is what this run was charged on the day it was generated. See
          <a href="/pricing" class={link} style={linkStyle}>current prices</a>.
        </p>

        {slots.map((slot) => (
          <section class="mt-6" data-sample-facts={slot.slot}>
            <h3 class="text-sm font-semibold text-fg">
              Sample input: <span class="font-mono font-normal">{slot.slot}</span>
            </h3>
            <dl class="mt-2 card p-0 divide-y divide-border text-sm">
              <div class="gallery-fact">
                <dt>Model</dt>
                <dd>
                  {modelsWithPages.has(slot.sample.generated_from.model)
                    ? <a href={modelPath(slot.sample.generated_from.model)} class:list={['font-mono', link]} style={linkStyle}>{slot.sample.generated_from.model}</a>
                    : <span class="font-mono">{slot.sample.generated_from.model}</span>}
                </dd>
              </div>
              {Object.entries(slot.sample.generated_from.params).map(([key, value]) => (
                <div class="gallery-fact">
                  <dt class="font-mono">{key}</dt>
                  <dd class="font-mono">{formatParam(value)}</dd>
                </div>
              ))}
              <div class="gallery-fact">
                <dt>Cost</dt>
                <dd data-sample-cost>{formatCost(slot.sample.generated_from.cost_cents)}</dd>
              </div>
              <div class="gallery-fact">
                <dt>Generated</dt>
                <dd><time datetime={slot.sample.generated_from.generated_on}>{formatDate(slot.sample.generated_from.generated_on)}</time></dd>
              </div>
            </dl>
            <details class="mt-2 text-sm">
              <summary class="cursor-pointer text-fg-muted">The prompt that made this sample</summary>
              <p class="mt-2 text-fg-muted" style="white-space: pre-wrap; overflow-wrap: anywhere" data-sample-prompt>{slot.sample.generated_from.prompt}</p>
            </details>
          </section>
        ))}
        {slots.length > 0 && (
          <p class="mt-3 text-sm text-fg-subtle" data-sample-cost-note>
            {slots.length === 1 ? 'The sample was' : 'The samples were'} generated on Godance and charged on
            {slots.length === 1 ? 'its' : 'their'} own, apart from the run.
          </p>
        )}

        <div class="mt-6" data-cta>
          {config.runThis ? (
            <a href={runThisUrl} class="btn btn-primary btn-lg w-full" data-run-this>Run this</a>
          ) : (
            <a href={getKeyUrl} class="btn btn-primary btn-lg w-full" data-get-key>Get an API key</a>
          )}
          {config.runThis && slots.length > 0 && (
            <p class="mt-2 text-sm text-fg-muted" data-run-own>
              Run this with your own {slots.length === 1 ? 'image' : 'images'}: it opens with
              {slots.length === 1 ? 'the sample' : 'the samples'} in place, ready to swap.
            </p>
          )}
        </div>
      </aside>
    </div>

    <!-- ===== The API call ===== -->
    <section class="mt-14">
      <h2 class="text-2xl font-bold text-fg">The API call</h2>
      {slots.length > 0 ? (
        <p class="mt-2 mb-4 text-fg-muted" data-api-intro="inputs">
          The requests that made this. Set <code class="code-chip">GODANCE_API_KEY</code> and paste them into
          a shell, one after the other: first upload {slots.length === 1 ? 'the input image' : 'each input image'},
          then send the request that names {slots.length === 1 ? 'it' : 'them'}. Uploading needs the input terms
          accepted once, in the app's settings. <code class="code-chip">gallery_recipe</code> says which recipe a
          run started from; it changes nothing about the result or its price. More in the
          <a href="/docs" class={link} style={linkStyle}>docs</a>.
        </p>
      ) : (
        <p class="mt-2 mb-4 text-fg-muted">
          The request that made this. Set <code class="code-chip">GODANCE_API_KEY</code> and paste it into a
          shell. <code class="code-chip">gallery_recipe</code> says which recipe a run started from; it
          changes nothing about the result or its price. More in the
          <a href="/docs" class={link} style={linkStyle}>docs</a>.
        </p>
      )}
      <ApiCall {recipe} run={firstRun} {mediaBase} idPrefix="run-0" />
    </section>

    <!-- ===== Run at scale: an assistant prompt, code, n8n ===== -->
    <RunAtScale {recipe} run={firstRun} {getKeyUrl} />

    <!-- ===== More runs of the same prompt ===== -->
    {otherRuns.length > 0 && (
      <section class="mt-14" data-other-runs>
        <h2 class="text-2xl font-bold text-fg">The same prompt on other models</h2>
        <div class="mt-6 space-y-10">
          {otherRuns.map((run, i) => (
            <div data-run={run.model}>
              <h3 class="text-lg font-semibold text-fg">
                <a href={modelPath(run.model)} class:list={['font-mono', link]} style={linkStyle}>{run.model}</a>
              </h3>
              <p class="mt-1 text-sm text-fg-muted">
                {formatCost(run.cost_cents)} ·
                <time datetime={run.generated_on}>{formatDate(run.generated_on)}</time> ·
                {run.prompt_lang === 'zh' ? 'Chinese' : 'English'} prompt
                {Object.entries(run.params).map(([key, value]) => (
                  <Fragment> · <span class="font-mono">{key}={formatParam(value)}</span></Fragment>
                ))}
                {slots.length > 0 && <Fragment> · the same sample {slots.length === 1 ? 'input' : 'inputs'}</Fragment>}
              </p>
              <div class="mt-4">
                <RunOutput {recipe} {run} {mediaBase} />
              </div>
              <details class="mt-4">
                <summary class="cursor-pointer text-sm font-semibold text-fg">The API call for this run</summary>
                <div class="mt-4">
                  <ApiCall {recipe} {run} {mediaBase} idPrefix={`run-${i + 1}`} />
                </div>
              </details>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ===== Credit ===== -->
    <section class="mt-14" data-credit>
      <h2 class="text-2xl font-bold text-fg">Credit</h2>
      <div class="mt-4 card text-sm text-fg-muted space-y-2.5">
        <p data-credit-prompt>
          Prompt by
          <a href={source.author_url} class={link} style={linkStyle} rel="noopener">{source.author}</a>
          (<a href={source.original_url} class={link} style={linkStyle} rel="noopener">original post</a>),
          from the list
          {listUrl
            ? <a href={listUrl} class:list={['font-mono', link]} style={linkStyle} rel="noopener">{source.list}</a>
            : <span class="font-mono">{source.list}</span>},
          licensed
          <a href={LICENCE_URLS[source.licence]} class={link} style={linkStyle} rel="license noopener" data-source-licence>{source.licence}</a>.
        </p>
        <p data-credit-changes>
          {source.changes.length > 0
            ? <Fragment>Changes from the original: {source.changes.join('; ')}.</Fragment>
            : 'The prompt is used as published, unchanged.'}
        </p>
        <p data-credit-output>
          The {isVideo ? 'video' : 'image'} on this page was generated by Godance from that prompt{slots.length > 0 && <Fragment>, and so {slots.length === 1 ? 'was the sample input' : 'were the sample inputs'}: {slots.length === 1 ? 'it comes' : 'they come'} from no list and no photo</Fragment>}.
          {config.outputLicence && <Fragment> {config.outputLicence}</Fragment>}
        </p>
        <p data-removal>
          Is this yours, and you would like it removed? Write to
          {contactIsEmail
            ? <Fragment><!--email_off--><a href={contactHref} class={link} style={linkStyle}>{config.removalContact}</a><!--/email_off--></Fragment>
            : <a href={contactHref} class={link} style={linkStyle}>{config.removalContact}</a>}
          and we will take it down.
        </p>
      </div>
    </section>

    <!-- ===== Related ===== -->
    {related.length > 0 && (
      <section class="mt-14" data-related>
        <h2 class="text-2xl font-bold text-fg">Related recipes</h2>
        <div class="mt-6 columns-2 md:columns-3 gap-4 [&>a]:mb-4">
          {related.map((other) => <RecipeCard recipe={other} {mediaBase} />)}
        </div>
      </section>
    )}
  </article>

  <script type="application/ld+json" set:html={scriptJson(recipeJsonLd(recipe, Astro.site ?? Astro.url, mediaBase))} />

  <!-- Inside the layout, so it lands in the body and not after </html>. -->
  <script is:inline>
    // Copy buttons: each names the element whose text it copies.
    (function () {
      // Say what happened on the button, then put its own label back.
      function answer(button, word) {
        var label = button.getAttribute('data-label');
        if (label === null) {
          label = button.textContent;
          button.setAttribute('data-label', label);
        }
        button.textContent = word;
        setTimeout(function () { button.textContent = label; }, 1600);
      }

      // No clipboard API, or the browser refused the write: select the text
      // and say so, so the reader can copy it themselves.
      function selectForReader(button, target) {
        var range = document.createRange();
        range.selectNodeContents(target);
        var selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
        answer(button, 'Selected');
      }

      [].forEach.call(document.querySelectorAll('[data-copy]'), function (button) {
        button.addEventListener('click', function () {
          var target = document.getElementById(button.getAttribute('data-copy'));
          if (!target) return;
          if (!navigator.clipboard || !navigator.clipboard.writeText) {
            selectForReader(button, target);
            return;
          }
          navigator.clipboard.writeText(target.textContent || '').then(
            function () { answer(button, 'Copied'); },
            function () { selectForReader(button, target); }
          );
        });
      });
    })();
  </script>
</Layout>

<style>
  .gallery-fact {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 1rem;
  }
  .gallery-fact dt {
    color: var(--color-fg-subtle);
  }
  .gallery-fact dd {
    color: var(--color-fg);
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>
