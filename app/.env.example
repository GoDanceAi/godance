# Copy to .env.local for local dev.
#
# Backend API base URL. Defaults to http://localhost:8080 if unset.
# Set to https://api.godance.ai in CF Pages production env.
VITE_API_URL=http://localhost:8080

# The marketing site that serves the gallery's recipes (/gallery/*.json), which
# the Studio loads for "Run this" links and its examples. Defaults to
# https://godance.ai if unset; point it at a local marketing build to try it.
# VITE_GALLERY_URL=http://localhost:4321
