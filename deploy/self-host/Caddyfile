# =====================================================================
# Godance (self-hosted) — Caddy: automatic TLS, the app and the API on one
# host name. The guide is docs/self-hosting.md.
#
# Adapted from the operator's production Caddyfile (backend/deploy/
# Caddyfile, unchanged): the same proxy headers, streaming, 5-minute
# timeouts and credential-free logs for the API. Production serves the app
# from Cloudflare Pages; here Caddy serves it too, with the headers the app
# ships for Pages (app/public/_headers).
#
# Every {$NAME} comes from the container's environment, set from .env by
# docker-compose.yml. GODANCE_URL is the site address:
#   https://godance.example.test     a server: Caddy obtains and renews a
#                                    Let's Encrypt certificate
#   http://godance.localhost:8080    a trial on one machine: plain HTTP
#
# A change to this file reaches the running proxy only when the container is
# recreated: docker compose up -d --force-recreate web
# =====================================================================

# Keeps credentials out of every log (copied from production): the whole
# query string goes, since URLs carry ?access_token=, OAuth codes and the
# signatures of storage links.
(redact_credentials) {
	format filter {
		wrap json
		fields {
			request>uri regexp "\?.*" "?REDACTED"
			request>headers>Referer delete
			resp_headers>Location delete
		}
	}
}

{
	email {$ACME_EMAIL}
	http_port {$HTTP_PORT}
	https_port {$HTTPS_PORT}
	# To test certificate issuance without Let's Encrypt's rate limits, use
	# its staging server, then remove this line and the caddy_data volume:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	log default {
		import redact_credentials
	}
}

{$GODANCE_URL} {
	# The API's routes. Everything else is the app.
	@api path /v1/* /healthz /actuator/* /mcp /mcp/* /oauth2/* /login/oauth2/*
	handle @api {
		reverse_proxy api:8080 {
			# The client's address for audit logs and per-IP rate limits.
			# Caddy also sets X-Forwarded-For, -Proto and -Host itself,
			# discarding any a client sent; production's two explicit
			# header_up lines for them only repeat that default.
			header_up X-Real-IP {remote_host}
			# Chat streams (SSE) flush as they arrive. Image requests
			# that wait for their job (godance.images.sync-wait, at most
			# 300s) and long uploads get five minutes, as in production.
			flush_interval -1
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}

	# Content-hashed bundles: cached for a year. A missing one is a 404,
	# never the app's index.html.
	handle /assets/* {
		root * /srv/app
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The app: client-side routes fall back to index.html.
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Production also sends includeSubDomains and preload. Those bind
		# every subdomain of your domain to HTTPS, so they are yours to add.
		Strict-Transport-Security "max-age=63072000"
		-Server
	}

	encode gzip zstd

	log {
		output stdout
		import redact_credentials
	}
}

# The files host for the bundled MinIO, when docker-compose.minio.yml mounts
# it. With external storage nothing matches, and Caddy only logs a warning.
import /etc/caddy/sites/*.caddy
