# =====================================================================
# Godance (self-hosted) — settings. Copy to .env and fill it in:
#
#   cp .env.example .env && chmod 600 .env
#
# The guide (docs/self-hosting.md) has a block of commands that fills in
# every secret. Every placeholder value must be replaced; the stack refuses
# to start while any is left (preflight.sh). Never commit .env.
#
# Docker Compose reads this file twice: to fill ${...} in the compose files,
# and as the API's environment. So any API setting from the configuration
# reference in the guide can be added here. Write NAME=value, with no
# quotes and no comment after the value.
# =====================================================================

# ---- Which files make the stack ---------------------------------------
# Bundled MinIO for object storage (the default):
COMPOSE_FILE=docker-compose.yml:docker-compose.minio.yml
# External S3-compatible storage instead: use this line, and set the
# OBJECT_STORAGE_* values below to your provider's.
# COMPOSE_FILE=docker-compose.yml

# ---- Addresses --------------------------------------------------------
# Where people reach Godance: the app and the API share this origin. Built
# into the app, so rebuild the web image after changing it.
GODANCE_URL=https://godance.example.test
# Where browsers fetch generated files (bundled MinIO only). It needs its own
# host name with its own DNS record; GODANCE_FILES_HOST is that name alone.
GODANCE_FILES_URL=https://files.godance.example.test
GODANCE_FILES_HOST=files.godance.example.test
# The ports Caddy listens on and publishes. 80 and 443 on a server.
HTTP_PORT=80
HTTPS_PORT=443
# Let's Encrypt writes here about certificates.
ACME_EMAIL=change-me@example.test
# The internal network between the API and the files host. Change it only
# if Docker reports that the pool overlaps another network.
STORAGE_SUBNET=172.30.253.0/28
#
# A trial on one machine, with no domain and no TLS, uses these instead
# (browsers and curl resolve any *.localhost name to this machine):
#   GODANCE_URL=http://godance.localhost:8080
#   GODANCE_FILES_URL=http://files.godance.localhost:8080
#   GODANCE_FILES_HOST=files.godance.localhost
#   HTTP_PORT=8080
#   HTTPS_PORT=8443

# ---- Region -----------------------------------------------------------
# digitalocean: every provider may be used, and the daily pricing check
# runs. alicloud: only providers on the fixed Alicloud allowlist are used;
# set it whenever this runs on Chinese-owned infrastructure. local: as
# digitalocean, without the pricing check. See "The regional allowlist".
REGION=digitalocean

# ---- Secrets: generate each, keep them, never share them ----------------
# Signs session tokens. openssl rand -hex 32
JWT_SIGNING_KEY=change-me
# Encrypts secrets stored in the database (two-factor secrets). Back it up
# apart from the database: without it nobody with two-factor sign-in on can
# sign in. openssl rand -base64 32
KEY_VAULT_KEY=change-me

# ---- Database ---------------------------------------------------------
DATABASE_USERNAME=godance
# openssl rand -hex 24
DATABASE_PASSWORD=change-me

# ---- Object storage ---------------------------------------------------
# Bundled MinIO: these are MinIO's own user name and password, and the API
# signs in with them. External storage: your provider's access key, secret
# and bucket.
OBJECT_STORAGE_ACCESS_KEY=godance
# openssl rand -hex 24
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=godance-files
# External storage only (docker-compose.minio.yml sets these for MinIO):
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_PATH_STYLE=false

# ---- The first admin --------------------------------------------------
# Comma-separated. Promoted to ADMIN at startup while no verified admin
# exists: sign up, verify the address, then restart the API once.
GODANCE_ADMIN_EMAILS=change-me@example.test

# ---- Email (Resend) ---------------------------------------------------
# Empty: no email is sent, and each message's first line (verification and
# password-reset links included) is written to the API's log instead.
RESEND_API_KEY=
EMAIL_FROM=Godance <noreply@example.test>

# ---- Payments (optional) ----------------------------------------------
# Leave all four empty to run without card or USDT top-ups: an admin then
# funds accounts in the admin console. An empty webhook secret refuses every
# webhook. Never put a made-up or short value in a webhook secret: the
# webhook credits whatever a validly signed message says.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Providers --------------------------------------------------------
# Set the keys you have. Every model stays listed whatever is set here; a
# request to a model whose provider has no key fails at that provider.
# Admins can switch models off in the admin console.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BFL_API_KEY=
VOLCENGINE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ALIBABA_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
XAI_API_KEY=
BAIDU_API_KEY=
STABILITY_API_KEY=
KLING_API_KEY=
RUNWAY_API_KEY=

# ---- Platform fee -----------------------------------------------------
# Percent added to the provider's cost, by modality. A model's own markup in
# the admin console's catalog wins over these.
TEXT_MARKUP_PERCENT=5
IMAGE_MARKUP_PERCENT=5
VIDEO_MARKUP_PERCENT=5

# ---- Java ---------------------------------------------------------------
# The production image's setting; fits a 4 GB server.
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC

# ---- Build --------------------------------------------------------------
# Shown as git_sha on /healthz. Set it from the checkout when building:
#   GIT_SHA=$(git rev-parse HEAD) docker compose build
GIT_SHA=unknown
# Where the Studio reads gallery recipes. Empty: https://godance.ai.
VITE_GALLERY_URL=
