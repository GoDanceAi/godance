# =====================================================================
# Godance — production environment template.
#
# Copy to .env.prod on the droplet, fill in REAL values, and put the
# file in a directory only root can read (chmod 600).
#
# NEVER commit the filled-in version to git. .gitignore in this folder
# excludes .env.prod by name.
# =====================================================================

# ---- Region + CORS --------------------------------------------------
# digitalocean | alicloud — controls the provider allowlist (fail-closed)
REGION=digitalocean
# Comma-separated browser origins allowed to call /v1/**. Prod default
# is the SPA on Cloudflare Pages. Add staging URLs if you have them.
CORS_ALLOWED_ORIGINS=https://app.godance.ai

# ---- JWT ------------------------------------------------------------
# Generate with: openssl rand -base64 48
# 32+ bytes required. Treat like any other root secret.
JWT_SIGNING_KEY=REPLACE_ME_WITH_48_BYTES_OF_BASE64
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=https://godance.ai

# ---- Database (Postgres) -------------------------------------------
# These point to the postgres container in docker-compose.prod.yml.
# If you switch to DO Managed Postgres later, update the URL accordingly.
DATABASE_URL=jdbc:postgresql://postgres:5432/godance
DATABASE_USERNAME=godance
# A strong password — generate with: openssl rand -base64 24
DATABASE_PASSWORD=REPLACE_ME_WITH_24_BYTES_OF_BASE64
DB_POOL_MAX=25
DB_POOL_MIN=5

# ---- Redis ----------------------------------------------------------
# Points to the redis container. AUTH disabled by default in dev; if you
# add `requirepass` to the redis container, set REDIS_PASSWORD here too.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Object storage (DO Spaces in prod) -----------------------------
# Create a bucket in the DigitalOcean dashboard, then mint a Spaces
# access key under API → Spaces Keys. The endpoint is region-specific.
OBJECT_STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com
OBJECT_STORAGE_REGION=nyc3
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
OBJECT_STORAGE_BUCKET=godance-prod
OBJECT_STORAGE_PRESIGN_TTL=7d
# DO Spaces is virtual-hosted style (false). MinIO is path-style (true).
OBJECT_STORAGE_PATH_STYLE=false

# ---- Stripe ---------------------------------------------------------
# For private beta: paste your TEST keys (sk_test_*, whsec_*).
# For live launch: switch to sk_live_* + a new whsec from the live mode endpoint.
# success-url / cancel-url should point to the deployed SPA, not localhost.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_SUCCESS_URL=https://app.godance.ai/dashboard?topup=success
STRIPE_CANCEL_URL=https://app.godance.ai/dashboard?topup=cancel
# Leave blank for the real Stripe API. Override only for test fixtures.
STRIPE_API_BASE=

# ---- Coinbase Commerce ---------------------------------------------
# NOTE: The legacy hosted Commerce product was sunset in 2026. The
# integration here will not process real payments against the live
# Coinbase API until migrated to the new Onchain Payment Protocol or
# swapped for an alternative (NOWPayments, Binance Pay). Safe to
# leave with dummy values for v0.1 if crypto payments aren't yet active.
COINBASE_API_KEY=cb_dummy_REPLACE_OR_LEAVE
COINBASE_WEBHOOK_SECRET=cb_dummy_REPLACE_OR_LEAVE
COINBASE_API_BASE=https://api.commerce.coinbase.com
COINBASE_API_VERSION=2018-03-22

# ---- NOWPayments (USDT crypto rail) ---------------------------------
# The live crypto top-up rail (replaces sunset Coinbase Commerce).
# API key + IPN secret come from the NOWPayments dashboard; register the
# IPN callback URL there as: https://api.godance.ai/v1/billing/webhooks/nowpayments
# Sandbox first (api-sandbox.nowpayments.io), then flip api-base to prod.
NOWPAYMENTS_API_KEY=np_REPLACE_ME
NOWPAYMENTS_IPN_SECRET=np_ipn_REPLACE_ME
NOWPAYMENTS_API_BASE=https://api.nowpayments.io

# ---- Admin (operator allowlist) -------------------------------------
# Comma-separated emails allowed on /v1/admin/** (pricing proposal
# approvals, catalog management). FAIL-CLOSED: if this is empty, every
# admin endpoint returns 403 for everyone — the dynamic-pricing cron
# will stage proposals that nobody can approve. Set it.
GODANCE_ADMIN_EMAILS=you@example.com

# ---- Billing knobs (defaults are fine) ------------------------------
TOPUP_MIN_CENTS=100
TOPUP_MAX_CENTS=100000
BILLING_CURRENCY=usd
TEXT_MARKUP_PERCENT=5
IMAGE_MARKUP_PERCENT=5
VIDEO_MARKUP_PERCENT=5

# ---- Provider keys --------------------------------------------------
# At least OPENAI_API_KEY is needed for chat. Others can be left as
# placeholders if you want to launch with OpenAI-only and add providers
# in a follow-up — the gateway will just route every request to OpenAI.
OPENAI_API_KEY=sk-proj-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME_OR_DUMMY
GOOGLE_API_KEY=AIza_REPLACE_ME_OR_DUMMY
BFL_API_KEY=bfl_REPLACE_ME_OR_DUMMY
VOLCENGINE_API_KEY=volc_REPLACE_ME_OR_DUMMY

# ---- Provider timing knobs (defaults are fine) ----------------------
OPENAI_TIMEOUT=30s
ANTHROPIC_TIMEOUT=60s
GOOGLE_TIMEOUT=60s
BFL_POLL_INTERVAL=2s
BFL_POLL_TIMEOUT=300s
VOLCENGINE_POLL_INTERVAL=5s
VOLCENGINE_POLL_TIMEOUT=600s

# ---- JVM / Java runtime --------------------------------------------
# Heap cap. 4GB droplet → 768m leaves room for Postgres + Redis + Caddy.
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
